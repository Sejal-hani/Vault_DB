# ==============================================================================
# VaultDB Configuration Template
# Copy this file to .env and configure for your local/production environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Relational Business Store
# ------------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=vaultdb
POSTGRES_USER=vault_user
POSTGRES_PASSWORD=vault_secure_password_here
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10

# Administrative credentials (used strictly by init_databases.py to create schemas and triggers)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_admin_password_here

# ------------------------------------------------------------------------------
# immudb Cryptographic Merkle Tree Ledger
# ------------------------------------------------------------------------------
IMMUDB_HOST=127.0.0.1
IMMUDB_PORT=3322
IMMUDB_USER=immudb
IMMUDB_PASSWORD=immudb
IMMUDB_DATABASE=defaultdb

# ------------------------------------------------------------------------------
# Web API & Security Workstation
# ------------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False

# ------------------------------------------------------------------------------
# Authentication & Cryptographic Tokens (RFC 7519 HS256 JWT)
# ------------------------------------------------------------------------------
SECRET_KEY=vlt_sec_replace_with_a_secure_random_64_char_hex_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# Behavioral Anomaly Detection Engine
# ------------------------------------------------------------------------------
# Maximum records retrieved before triggering an Unusual Bulk Data Access anomaly
BULK_ROW_THRESHOLD=1000

# Maximum rows modified in single UPDATE/DELETE before triggering Bulk Modification anomaly
BULK_MODIFICATION_THRESHOLD=10

# Configured internal employee banking hours in Indian Standard Time (IST)
WORKING_HOURS_START_IST=9
WORKING_HOURS_END_IST=18

# Rapid access denials threshold (e.g. 2 denials within 300 seconds)
DENIAL_THRESHOLD=2
DENIAL_WINDOW_SECONDS=300

# ------------------------------------------------------------------------------
# Real-Time Alert Webhooks (Optional)
# ------------------------------------------------------------------------------
# Slack Incoming Webhook URL for real-time security anomaly dispatch
SLACK_WEBHOOK_URL=
