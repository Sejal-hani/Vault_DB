{
  "name": "vault-db",
  "version": "2.0.0",
  "description": "Cryptographically Immutable Database Middleware with PostgreSQL & immudb (Node.js)",
  "main": "src/api/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/api/server.js",
    "dev": "node --watch src/api/server.js",
    "services": "node scripts/startServices.js",
    "init-db": "node scripts/initDb.js",
    "test": "node --test tests/*.test.js",
    "verify": "node scripts/verifyIntegrity.js",
    "benchmark": "node scripts/benchmark.js"
  },
  "keywords": [
    "immudb",
    "audit-logging",
    "postgresql",
    "cryptography",
    "compliance",
    "gdpr",
    "hipaa",
    "rbac"
  ],
  "author": "VaultDB Team",
  "license": "Apache-2.0",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pdfkit": "^0.16.0",
    "pg": "^8.13.1"
  }
}
